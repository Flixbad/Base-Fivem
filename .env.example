# Copie ce fichier vers .env et remplis les valeurs.
# Ne commit JAMAIS le fichier .env.

# Clé serveur Cfx.re : https://portal.cfx.re/servers/subscription
SV_LICENSE_KEY=changeme

# MariaDB
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=fivem
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=qbox

# Format attendu par oxmysql / server.cfg
# mysql_connection_string=mysql://fivem:change_me@127.0.0.1/qbox?charset=utf8mb4

# Serveur
SERVER_NAME=Base Locale Qbox
SERVER_MAX_CLIENTS=8
SERVER_ENDPOINT_TCP=0.0.0.0:30120
SERVER_ENDPOINT_UDP=0.0.0.0:30120
LOCALE=fr-FR
QB_LOCALE=fr
OX_LOCALE=fr

# txAdmin (souvent géré automatiquement au premier lancement)
TXADMIN_PORT=40120
